# --------------------------------------------------------------
# 8. Combined Equity ECDF Figure (3 panels)
# --------------------------------------------------------------
make_ecdf_panel <- function(df, fill_option = "C", legend_title, main_title) {
df_ord <- df %>%
order_bins_local() %>%
mutate(var_bin = factor(var_bin, levels = unique(var_bin)))
med_df <- df_ord %>%
group_by(var_bin) %>%
summarise(med = median(metric_value, na.rm = TRUE), .groups = "drop")
n_bins   <- nrow(med_df)
pal_cols <- viridisLite::viridis(n_bins, option = "D", end = 0.82)
# Header line in grey, each bin line colored to match its CDF line
box_lines <- c(
"<span style='color:grey30'><b>Median %WW</b></span>",
mapply(function(bin, med, col) {
sprintf("<span style='color:%s'>%s: %.1f%%</span>", col, bin, med)
}, med_df$var_bin, med_df$med, pal_cols, SIMPLIFY = TRUE)
)
box_label <- paste(box_lines, collapse = "<br>")
med_grob <- gridtext::richtext_grob(
text     = box_label,
x        = unit(0.98, "npc"),
y        = unit(0.04, "npc"),
hjust    = 1,
vjust    = 0,
padding  = unit(c(4, 6, 4, 6), "pt"),
box_gp   = gpar(fill = "white", col = "grey70", lwd = 0.8),
gp       = gpar(fontsize = 7.5)
)
ggplot(df_ord, aes(x = metric_value, colour = var_bin, group = var_bin)) +
stat_ecdf(geom = "step", linewidth = 0.85, pad = FALSE) +
geom_vline(
data     = med_df,
aes(xintercept = med, colour = var_bin),
linetype = "dashed", linewidth = 0.4, alpha = 0.55
) +
annotation_custom(
grob = med_grob,
xmin = -Inf, xmax = Inf,
ymin = -Inf, ymax = Inf
) +
scale_colour_viridis_d(option = "D", end = 0.82, name = legend_title) +
scale_x_continuous(
limits = c(0, 100), breaks = seq(0, 100, by = 20),
labels = function(x) paste0(x, "%")
) +
scale_y_continuous(
limits = c(0, 1), breaks = seq(0, 1, by = 0.2),
labels = percent_format(accuracy = 1)
) +
labs(
x     = "% Wastewater Among Impacted Segments",
y     = "Cumulative Probability",
title = main_title
) +
theme_ms() +
theme(
legend.position = "bottom",
legend.key.size = unit(0.55, "cm"),
legend.text     = element_text(size = 8),
legend.title    = element_text(size = 9, face = "bold")
)
}
