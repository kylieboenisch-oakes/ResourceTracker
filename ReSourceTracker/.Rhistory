# --------------------------------------------------------------
# 7. Nitrate & Conductivity vs Average %WW
# --------------------------------------------------------------
nitrate_cond <- read_excel(xlsx_path, sheet = "Nitrate_CondVEstimate") %>%
rename(
site        = Site,
month_year  = `Mon. + Year`,
cond_pct    = `Cond.`,
nitrate_pct = Nitrate,
avg_pct     = `Average (%)`
) %>%
mutate(
across(c(cond_pct, nitrate_pct, avg_pct), ~ {
x <- as.numeric(.x)
if (all(x[!is.na(x)] <= 1)) x * 100 else x
}),
site = factor(site)
)
nc_axis_max  <- 100
site_levels  <- levels(nitrate_cond$site)
nc_shapes    <- c(16, 17, 15, 18, 8, 10)[seq_along(site_levels)]
names(nc_shapes) <- site_levels
nc_colors    <- brewer.pal(max(3, length(site_levels)), "Dark2")[seq_along(site_levels)]
names(nc_colors) <- site_levels
fit_label <- function(df, x_col, y_col) {
fit      <- lm(df[[y_col]] ~ df[[x_col]])
slope    <- coef(fit)[2]
inter    <- coef(fit)[1]
r2       <- summary(fit)$r.squared
sign_str <- ifelse(inter >= 0, "+", "-")
sprintf("y = %.2fx %s %.1f\nR² = %.2f", slope, sign_str, abs(inter), r2)
}
lab_cond <- fit_label(nitrate_cond, "cond_pct", "avg_pct")
p_cond_vs_avg <- ggplot(nitrate_cond,
aes(x = cond_pct, y = avg_pct, colour = site, shape = site)) +
geom_abline(slope = 1, intercept = 0,
linetype = "dashed", colour = "grey50", linewidth = 0.7) +
geom_smooth(method = "lm", formula = y ~ x, se = TRUE,
colour = "grey30", fill = "grey70", alpha = 0.15, linewidth = 0.9,
inherit.aes = FALSE,
aes(x = cond_pct, y = avg_pct), data = nitrate_cond) +
geom_point(size = 3.2, alpha = 0.9) +
annotate("text", x = 0.02 * nc_axis_max, y = 0.98 * nc_axis_max,
label = lab_cond, hjust = 0, vjust = 1,
size = 4, fontface = "italic", colour = "black") +
scale_colour_manual(values = nc_colors, name = "Site") +
scale_shape_manual(values  = nc_shapes, name = "Site") +
scale_x_continuous(limits = c(0, nc_axis_max), breaks = seq(0, nc_axis_max, 20),
labels = function(x) paste0(x, "%")) +
scale_y_continuous(limits = c(0, nc_axis_max), breaks = seq(0, nc_axis_max, 20),
labels = function(x) paste0(x, "%")) +
coord_fixed() +
labs(x = "Conductivity-Estimated %WW", y = "Multi-Constituent Average %WW",
title = "Conductivity vs. Average %WW") +
theme_ms()
lab_nit <- fit_label(nitrate_cond, "nitrate_pct", "avg_pct")
p_nit_vs_avg <- ggplot(nitrate_cond,
aes(x = nitrate_pct, y = avg_pct, colour = site, shape = site)) +
geom_abline(slope = 1, intercept = 0,
linetype = "dashed", colour = "grey50", linewidth = 0.7) +
geom_smooth(method = "lm", formula = y ~ x, se = TRUE,
colour = "grey30", fill = "grey70", alpha = 0.15, linewidth = 0.9,
inherit.aes = FALSE,
aes(x = nitrate_pct, y = avg_pct), data = nitrate_cond) +
geom_point(size = 3.2, alpha = 0.9) +
annotate("text", x = 0.02 * nc_axis_max, y = 0.98 * nc_axis_max,
label = lab_nit, hjust = 0, vjust = 1,
size = 4, fontface = "italic", colour = "black") +
scale_colour_manual(values = nc_colors, name = "Site") +
scale_shape_manual(values  = nc_shapes, name = "Site") +
scale_x_continuous(limits = c(0, nc_axis_max), breaks = seq(0, nc_axis_max, 20),
labels = function(x) paste0(x, "%")) +
scale_y_continuous(limits = c(0, nc_axis_max), breaks = seq(0, nc_axis_max, 20),
labels = function(x) paste0(x, "%")) +
coord_fixed() +
labs(x = "Nitrate-Estimated %WW", y = "Multi-Constituent Average %WW",
title = "Nitrate vs. Average %WW") +
theme_ms()
legend_nc <- get_legend(p_nit_vs_avg + theme(legend.position = "right"))
p_nc_final <- plot_grid(
plot_grid(
p_cond_vs_avg + theme(legend.position = "none"),
p_nit_vs_avg  + theme(legend.position = "none"),
nrow = 1, labels = c("A", "B")
),
legend_nc,
nrow = 1, rel_widths = c(1, 0.12)
)
title_nc <- ggdraw() +
draw_label("Single-Constituent Estimates vs. Multi-Constituent Average %WW",
fontface = "bold", size = 13, hjust = 0.5)
subtitle_nc <- ggdraw() +
draw_label("Dashed line = 1:1 agreement; shaded band = 95% CI of regression",
size = 10, hjust = 0.5)
p_nc_final <- plot_grid(title_nc, subtitle_nc, p_nc_final,
ncol = 1, rel_heights = c(0.05, 0.03, 1))
print(p_nc_final)
